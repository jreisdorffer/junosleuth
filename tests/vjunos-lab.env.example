# Copy this file outside the repository or to tests/vjunos-lab.env and adjust it
# for your lab host. Do not commit real keys, passwords, or customer hostnames.

REMOTE_HOST=vjunos-lab-host
LOCAL_IMAGE=/path/to/vJunos-router.qcow2

VM_NAME=junosleuth-vjunos
REMOTE_BASE_IMAGE=/var/lib/libvirt/images/vJunos-router-26.2R1.7-base.qcow2
REMOTE_OVERLAY_IMAGE=/var/lib/libvirt/images/junosleuth-vjunos-live.qcow2

VCPUS=4
RAM_MB=8192

MGMT_NETWORK=default
DATA_NETWORK_0=vjunos-ge000
DATA_NETWORK_1=vjunos-ge001

MGMT_MAC=52:54:00:06:1f:a5
DATA_MAC_0=52:54:00:3e:b5:2e
DATA_MAC_1=52:54:00:de:dd:0e

REMOTE_STATE_DIR=/var/lib/junosleuth-lab
